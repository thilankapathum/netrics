----- DUMPING ALL DATABASES -----

# Full cluster dump (captures ALL databases, roles, tablespaces)
docker exec postgres pg_dumpall \
  -U pguser \
  > backup_$(date +%Y%m%d_%H%M%S)_full_cluster.sql

# ALSO individual per-database dumps as insurance
for DB in pulse_db keycloak; do
  docker exec postgres pg_dump \
    -U pguser -Fc $DB \
    > backup_$(date +%Y%m%d_%H%M%S)_${DB}.dump
done

